{
  "name": "@snow-the/dsh-skill-pack",
  "version": "0.1.0",
  "description": "Curated engineering skills for DeepSeek Harness: handoff, grilling, teach, spec/ticket workflows, writing skills, and the DESIGN.md format. Cross-platform (pure SKILL.md text, no platform code).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "skills",
    "deepseek-harness",
    "cross-platform"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/"
  },
  "files": [
    "dist",
    "skills",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
